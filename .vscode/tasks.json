{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build",
			"type": "shell",
			"windows": {
				"command": "fabricare",
			},
			"problemMatcher": [
				"$msCompile",
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Clean",
			"type": "shell",
			"windows": {
				"command": "fabricare clean",
			},
			"problemMatcher": [
				"$msCompile",
				"$gcc"
			]
		},
		{
			"label": "Release",
			"type": "shell",
			"windows": {
				"command": "fabricare release",
			},
			"problemMatcher": [
				"$msCompile",
				"$gcc"
			]
		},
		{
			"label": "Version",
			"type": "shell",
			"windows": {
				"command": "fabricare version",
			},
			"problemMatcher": [
				"$msCompile",
				"$gcc"
			]
		}
	]
}